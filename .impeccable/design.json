      "html": "<button class=\"ds-arrow\" type=\"button\" aria-label=\"Fotografía siguiente\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
