      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:54px;padding:15px 24px;border-radius:999px;border:0;background:var(--violet,#6041a6);color:var(--white,#fff);font:600 1rem/1.35 var(--font,'Figtree','Segoe UI',sans-serif);cursor:pointer;transition:background 180ms,transform 250ms var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:transform 250ms}.ds-button:hover{background:var(--violet-deep,#39235e);transform:translateY(-2px)}.ds-button:hover svg{transform:translateX(3px)}.ds-button:active{transform:translateY(0)}.ds-button:focus-visible{outline:3px solid var(--violet,#6041a6);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button,.ds-button svg{transition:none;transform:none!important}}"
